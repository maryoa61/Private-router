# ============================================================
#  Private Router — نمونه‌ی متغیرهای محیطی
#  این فایل کامیت می‌شود؛ فایل .env واقعی در .gitignore است.
# ============================================================
#
#  ⚠️  هشدار: هر متغیری که با VITE_ شروع شود، هنگام build داخل
#  فایل‌های JavaScript عمومی جاسازی می‌شود و هر بازدیدکننده‌ای
#  می‌تواند آن را ببیند. این متغیرها فقط از مخزن git بیرون
#  می‌مانند و «محرمانه» نیستند.
#
#  حالت این پروژه ساده است: هر کاربر API Key + Base URL خودش را
#  در برنامه (دکمه‌ی «افزودن سرویس») وارد می‌کند و همان‌جا در
#  localStorage مرورگرش ذخیره می‌شود. هیچ بک‌اند/دیتابیسی وجود
#  ندارد و کلید هیچ‌وقت جای دیگری فرستاده نمی‌شود مگر مستقیم به
#  provider (OpenAI / Anthropic / ...) یا از طریق CORS Proxy زیر.
# ------------------------------------------------------------

# آدرس CORS Proxy Worker (فایل worker.js در ریشه‌ی پروژه). محرمانه نیست
# (در هر درخواست شبکه دیده می‌شود)، ولی برای اینکه در ریپوی عمومی نباشد
# از این متغیر تزریق می‌شود. اگر provider مستقیم از مرورگر قابل‌دسترسی
# باشد (مثل OpenAI) لازم نیست؛ برای Anthropic معمولاً لازم است.
# قالب توصیه‌شده: https://<worker>.<subdomain>.workers.dev/?url={url}
# قالب append هم پشتیبانی می‌شود: https://<worker>.workers.dev
VITE_CORS_PROXY_URL=""

# رمز ورود به بخش /admin. چون در باندل عمومی است، فقط یک قفل UI است.
VITE_ADMIN_TOKEN=""

# اختیاری — فقط برای دیپلوی خصوصی/داخلی.
# برای سایت عمومی خالی بگذارید تا هر کاربر توکن خودش را
# در Settings وارد کند و توکن در باندل لو نرود.
VITE_WORKER_PROXY_TOKEN=""

# ------------------------------------------------------------
#  یادآوری درباره‌ی خود Worker (فایل worker.js):
#  از نسخه‌ی v4 پیکربندی ناقص دیگر fail-open نیست. قبل از استفاده باید
#  هر سه مورد ست شوند، وگرنه ورکر ۵۰۳ برمی‌گرداند:
#    wrangler secret put PROXY_TOKEN
#    wrangler deploy --var ALLOWED_ORIGINS:"https://your-site.pages.dev" \
#                    --var ALLOW_HOSTS:"api.anthropic.com,api.openai.com"
# ------------------------------------------------------------
